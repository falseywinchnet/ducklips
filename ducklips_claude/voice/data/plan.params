# The planner's parameter tree as m69 plans the NATO words (say --pressure 750,
# the articulatory body): the start of the timing and articulation fit
# (tract/analysis/engine_net.py). Format: voice/include/voice/plan_parameters.hpp.
timing {
  rate 1
  variation 0.1
  lead_in 0.1
  seal_lead 0.4
  vowel_hold 0.6
  seal_settle 0.025
  affricate_hiss_max 0.06
  affricate_hiss_at 0.3
  release_move 0.03
  voiced_release_move 0.05
  burst_scale 1
  release_peel_time 0.015
  voice_lag 0.02
  vowel_reach 0.35
  vowel_arrival 0.8
  jaw_lead 0.04
  fricative_hold 0
  final_vowel_scale 1.8
  final_consonant_scale 1.6
  final_vowel_floor_ms 110
  comma_vowel_scale 2.4
  sonorant_devoicing 0.5
}
glottis {
  voicing_gap -0.006
  voiced_fricative_gap 0.04
  aspirate_gap 0.06
  unstressed_gap 0
  stress_press 0
  final_relax_gap -0.008
  vowel_compression 0.6
  unstressed_compression 0.6
  onset_gap -1
  onset_hold 0.02
  onset_settle 0.03
  fricative_abduct_lead 0.03
