}
release {
  release_channel 0.6
  release_peel_area 0
}
pitch {
  base_pitch 120
  pitch_floor 100
  accent 22
  accent_peak 0.05
  accent_fall 0.25
  unstressed_drift 0.06
  unstressed_dip 0.5
  pitch_spread 1.5
  pitch_median 122
  lowest_pitch 80
  final_fall 0.9
  comma_pitch 0.93
}
